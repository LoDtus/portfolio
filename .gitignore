# ==========================================
# 1. DEPENDENCIES
# ==========================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================================
# 2. BUILDS & OUTPUTS
# ==========================================
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts

# ==========================================
# 3. ENVIRONMENT & SECRETS
# ==========================================
.env
.env*.local
.env.development
.env.production
.env.staging
!.env.example

# Security Keys / Certificates
*.pem
*.pub
*.key

# Cloudflare Wrangler (cache và trạng thái cục bộ)
.wrangler/

# ==========================================
# 4. LOGS & TEMPORARY FILES
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# System files
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db

# ==========================================
# 5. IDE & TOOLS CONFIG
# ==========================================
.vscode/*
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel

# ==========================================
# 6. DOCKER & CONTAINER CACHE
# ==========================================
.docker

# ==========================================
# 7. CLAUDE CODE, PLAYWRIGHT & GHI CHÚ CÁ NHÂN
# ==========================================
# Không đưa .claude/ (rules, skills, cài đặt Claude Code) vào repo; CLAUDE.md vẫn được commit.
.claude/
CLAUDE.local.md
.playwright-mcp/

# Ảnh gốc chưa tối ưu (nặng, chỉ giữ ở máy) và ghi chú cá nhân
